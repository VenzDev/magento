<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="training_greeting" translate="label" type="text" sortOrder="500"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Training Greeting</label>
            <tab>general</tab>
            <resource>Training_Greeting::greeting</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="retention_days" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Retention (days)</label>
                    <comment>Wpisy training_greeting starsze niż ta liczba dni są usuwane przez cron job training_greeting_cleanup (patrz etc/crontab.xml).</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
