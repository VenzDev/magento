<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Training\Greeting\Api\Data\GreetingInterface" type="Training\Greeting\Model\Greeting"/>
    <preference for="Training\Greeting\Api\GreetingRepositoryInterface" type="Training\Greeting\Model\GreetingRepository"/>
    <preference for="Training\Greeting\Api\GreetingSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>

    <type name="Training\Greeting\Api\GreetingRepositoryInterface">
        <plugin name="training_greeting_reindex_count" type="Training\Greeting\Plugin\ReindexGreetingCountPlugin"/>
    </type>

    <!--
        Rejestracja kolekcji gridowej pod nazwą data source'a z listing.xml.
        Generyczna klasa Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider
        (użyta w listing.xml jako "class") sama nie wie nic o naszej encji —
        znajduje właściwą kolekcję właśnie po tym mapowaniu nazwa -> klasa.
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="training_greeting_listing_data_source" xsi:type="string">Training\Greeting\Model\ResourceModel\Greeting\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
